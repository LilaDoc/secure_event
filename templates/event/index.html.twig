{% extends 'base.html.twig' %}

{% block title %}Event index
{% endblock %}

{% block body %}
	<h1>Event index</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>Titre</th>
				<th>Description</th>
				<th>DateDebut</th>
				<th>CapaciteMax</th>
				<th>Place</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for event in events %}
				<tr>
					<td>{{ event.id }}</td>
					<td>{{ event.titre }}</td>
					<td>{{ event.description }}</td>
					<td>{{ event.dateDebut ? event.dateDebut|date('Y-m-d H:i:s') : '' }}</td>
					<td>{{ event.capaciteMax }}</td>
					<td>{{ event.lieu }}</td>
					<td>
						<a href="{{ path('app_event_show', {'id': event.id}) }}">show</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="8">Aucun événement à venir</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

{% endblock %}
