{% extends 'base.html.twig' %}

{% block title %}Event
{% endblock %}

{% block body %}
	<h1>Event</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ event.id }}</td>
			</tr>
			<tr>
				<th>Titre</th>
				<td>{{ event.titre }}</td>
			</tr>
			<tr>
				<th>Description</th>
				<td>{{ event.description }}</td>
			</tr>
			<tr>
				<th>DateDebut</th>
				<td>{{ event.dateDebut ? event.dateDebut|date('Y-m-d H:i:s') : '' }}</td>
			</tr>
			<tr>
				<th>CapaciteMax</th>
				<td>{{ event.capaciteMax }}</td>
			</tr>
			<tr>
				<th>IsPublished</th>
				<td>{{ event.isPublished ? 'Yes' : 'No' }}</td>
			</tr>
			<tr>
				<th>Place</th>
				<td>{{ event.lieu }}</td>
			</tr>
		</tbody>
	</table>
	        {% if event.reservation.contains(app.user) %}
            <p>✅ Vous êtes déjà inscrit</p>
        {% elseif event.reservation|length == event.capaciteMax %}
            <p>L'evenement est complet.</p>
        {% else %}
            <form method="post" action="{{ path('app_event_inscription', {id: event.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('inscription' ~ event.id) }}">
                <button type="submit" class="btn btn-primary">S'inscrire</button>
            </form>
        {% endif %}
	<a href="{{ path('app_event_index') }}">back to list</a>

{% endblock %}
