{% extends 'base.html.twig' %}

{% block title %}
	{{ event.titre }}
	— Participants — Admin
{% endblock %}

{% block body %}
	<div class="container-fluid px-0">
		<div
			class="admin-wrap">

			{# ── SIDEBAR ── #}
			<aside class="sidebar">
				<div class="sidebar-logo">
					<span class="dot"></span>
					SecurEvent
				</div>
				<nav class="sidebar-nav">
					<div class="nav-label">Navigation</div>
					<a href="{{ path('app_admin_dashboard') }}" class="nav-link">
						<svg fill="none" viewbox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
						Dashboard
					</a>
					<div class="nav-label">Gestion</div>
					<a href="#" class="nav-link active">
						<svg fill="none" viewbox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
						Participants
					</a>
				</nav>
				<div class="sidebar-footer">
					Connecté :<br>
					<strong>{{ app.user.email }}</strong><br>
					<a href="{{ path('app_logout') }}">Se déconnecter</a>
				</div>
			</aside>

			{# ── MAIN ── #}
			<main
				class="admin-main">

				{# Breadcrumb #}
				<nav style="font-size:0.75rem; color:#64748b; margin-bottom:20px; font-family:'JetBrains Mono',monospace;">
					<a href="{{ path('app_admin_dashboard') }}" style="color:#22d3ee; text-decoration:none;">Dashboard</a>
					<span style="margin:0 8px;">›</span>
					<a href="{{ path('admin_event_show', {'id': event.id}) }}" style="color:#22d3ee; text-decoration:none;">{{ event.titre }}</a>
					<span style="margin:0 8px;">›</span>
					<span>Participants</span>
				</nav>

				{# Flash #}
				{% for msg in app.flashes('success') %}
					<div class="flash flash-success">{{ msg }}</div>
				{% endfor %}
				{% for msg in app.flashes('danger') %}
					<div class="flash flash-danger">{{ msg }}</div>
				{% endfor %}

				{# Page header #}
				<div class="admin-page-header">
					<div>
						<h1 class="admin-page-title">
							Participants
							<span class="count">({{ participants|length }}
								/
								{{ event.capaciteMax }})</span>
						</h1>
						<p style="font-size:0.8rem; color:#64748b; margin:4px 0 0; font-family:'JetBrains Mono',monospace;">
							{{ event.titre }}
						</p>
					</div>
					<a href="{{ path('admin_event_show', {'id': event.id}) }}" class="btn btn-sm" style="border:1px solid rgba(255,255,255,0.1); color:#64748b; background:transparent;">
						← Retour à l'événement
					</a>
				</div>

				{# Participants panel #}
				<div class="panel">
					<div class="table-wrap">
						{% if participants|length > 0 %}
							<table class="table mb-0">
								<thead>
									<tr>
										<th>#</th>
										<th>Nom</th>
										<th>Prénom</th>
										<th>Email</th>
									</tr>
								</thead>
								<tbody>
									{% for participant in participants %}
										<tr>
											<td style="color:#64748b; font-family:'JetBrains Mono',monospace; font-size:0.72rem;">
												{{ loop.index }}
											</td>
											<td style="font-weight:500; color:#f0f6ff;">{{ participant.nom }}</td>
											<td style="color:#f0f6ff;">{{ participant.prenom }}</td>
											<td style="color:#64748b; font-family:'JetBrains Mono',monospace; font-size:0.8rem;">{{ participant.email }}</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						{% else %}
							<div class="empty-state">
								<svg fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
								</svg>
								<p>Aucun participant inscrit pour le moment.</p>
							</div>
						{% endif %}
					</div>
				</div>

				{# Capacity bar #}
				{% if participants|length > 0 %}
					<div style="margin-top:1rem; padding:1rem 1.25rem; background:#0d1117; border:1px solid rgba(255,255,255,0.06); border-radius:10px; display:flex; align-items:center; gap:1rem;">
						<span style="font-size:0.75rem; color:#64748b; font-family:'JetBrains Mono',monospace; white-space:nowrap;">
							Remplissage
						</span>
						<div style="flex:1; background:rgba(255,255,255,0.06); border-radius:100px; height:6px; overflow:hidden;">
							{% set pct = (participants|length / event.capaciteMax * 100)|round %}
							<div style="width:{{ pct }}%; height:100%; background:{% if pct >= 90 %}#f87171{% elseif pct >= 60 %}#fbbf24{% else %}#22d3ee{% endif %}; border-radius:100px; transition:width 0.3s;"></div>
						</div>
						<span style="font-size:0.75rem; color:#f0f6ff; font-family:'JetBrains Mono',monospace; white-space:nowrap;">
							{{ pct }}%
						</span>
					</div>
				{% endif %}

			</main>
		</div>
	</div>
{% endblock %}
