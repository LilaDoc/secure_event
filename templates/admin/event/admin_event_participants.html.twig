{% extends 'base.html.twig' %}

{% block title %}
	{{ event.titre }}
	— Admin
{% endblock %}

{% block body %}
	<div class="container-fluid px-0">
		<div
			class="admin-wrap">

			{# ── SIDEBAR ── #}
			<aside class="sidebar">
				<div class="sidebar-logo">
					<span class="dot"></span>
					SecurEvent
				</div>
				<nav class="sidebar-nav">
					<div class="nav-label">Navigation</div>
					<a href="{{ path('app_admin_dashboard') }}" class="nav-link">
						<svg fill="none" viewbox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
						Dashboard
					</a>
					<div class="nav-label">Gestion</div>
					<a href="#" class="nav-link active">
						<svg fill="none" viewbox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
						Détail événement
					</a>
				</nav>
				<div class="sidebar-footer">
					Connecté :
					<strong>{{ app.user.email }}</strong><br>
					<a href="{{ path('app_logout') }}">Se déconnecter</a>
				</div>
			</aside>

			{# ── MAIN ── #}
			<main
				style="flex:1;padding:28px;min-width:0;">

				{# Breadcrumb #}
				<nav style="font-size:0.75rem;color:var(--sec-text-muted);margin-bottom:20px;">
					<a href="{{ path('app_admin_dashboard') }}" style="color:var(--sec-green);text-decoration:none;">Dashboard</a>
					<span style="margin:0 8px;">›</span>
					<span>{{ event.titre }}</span>
				</nav>

				{# Flash #}
				{% for msg in app.flashes('success') %}
					<div class="flash flash-success">{{ msg }}</div>
				{% endfor %}
				{% for msg in app.flashes('danger') %}
					<div class="flash flash-danger">{{ msg }}</div>
				{% endfor %}

				{# ── HEADER ── #}
				< style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid var(--sec-border);">
					<div>
						<div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
							<h1 style="font-family:var(--font-display);font-size:1.6rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin:0;">
								{{ event.titre }}
							</h1>
							{% if event.isPublished %}
								<span class="badge badge-published">Publié</span>
							{% else %}
								<span class="badge badge-draft">Brouillon</span>
							{% endif %}
							{% if event.dateDebut > date() %}
								<span class="badge badge-upcoming">À venir</span>
							{% else %}
								<span class="badge badge-past">Passé</span>
							{% endif %}
						</div>
						<p style="font-size:0.78rem;color:var(--sec-text-muted);margin:0;">
							ID #{{ event.id }}
							— créé dans la base de données
						</p>
					</div>
					<div style="display:flex;gap:8px;flex-shrink:0;">
						<a href="{{ path('admin_event_edit', {'id': event.id}) }}" class="btn btn-outline-success btn-sm">
							<svg fill="none" viewbox="0 0 24 24" stroke="currentColor" style="width:13px;height:13px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
							Modifier
						</a>
						<form method="post" action="{{ path('admin_event_delete', {'id': event.id}) }}" onsubmit="return confirm('Supprimer définitivement cet événement ?');" style="display:inline;">
							<input type="hidden" name="_token" value="{{ csrf_token('delete-event-' ~ event.id) }}">
							<button type="submit" class="btn btn-outline-danger btn-sm">
								<svg fill="none" viewbox="0 0 24 24" stroke="currentColor" style="width:13px;height:13px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
								Supprimer
							</button>
						</form>
						<a href="{{ path('app_admin_dashboard') }}" class="btn btn-sm" style="border:1px solid var(--sec-border);color:var(--sec-text-muted);">
							← Retour
						</a>
					</div>
					<div style="display:flex;gap:8px;flex-shrink:0;">
						<a href="{{ path('app_event_change_capacity', {'id': event.id}) }}" class="btn btn-outline-success btn-sm">
							<svg fill="none" viewbox="0 0 24 24" stroke="currentColor" style="width:13px;height:13px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
							Modifier
						</a>
						<form method="post" action="{{ path('admin_event_change_capacity', {'id': event.id}) }}" onsubmit="return confirm('Supprimer définitivement cet événement ?');" style="display:inline;">
							<input type="hidden" name="_token" value="{{ csrf_token('delete-event-' ~ event.id) }}">
							<button type="submit" class="btn btn-outline-danger btn-sm">
								<svg fill="none" viewbox="0 0 24 24" stroke="currentColor" style="width:13px;height:13px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
								Supprimer
							</button>
						</form>
						<a href="{{ path('app_admin_dashboard') }}" class="btn btn-sm" style="border:1px solid var(--sec-border);color:var(--sec-text-muted);">
							← Retour
						</a>
					</div>
				</div>

				{# ── PARTICIPANTS ── #}
				<div class="panel" style="margin-bottom:20px;">
					<div class="panel-header" style="display:flex;justify-content:space-between;align-items:center;">
						<span class="panel-title">Participants inscrits ({{ participants|length }} / {{ event.capaciteMax }})</span>
					</div>
					<div style="padding:20px;">
						{% if participants|length > 0 %}
							<table style="width:100%;font-size:0.82rem;border-collapse:collapse;">
								<thead>
									<tr style="border-bottom:2px solid var(--sec-border);text-align:left;">
										<th style="padding:10px 0;color:var(--sec-text-muted);font-size:0.7rem;letter-spacing:0.8px;text-transform:uppercase;">#</th>
										<th style="padding:10px 0;color:var(--sec-text-muted);font-size:0.7rem;letter-spacing:0.8px;text-transform:uppercase;">Nom</th>
										<th style="padding:10px 0;color:var(--sec-text-muted);font-size:0.7rem;letter-spacing:0.8px;text-transform:uppercase;">Prénom</th>
										<th style="padding:10px 0;color:var(--sec-text-muted);font-size:0.7rem;letter-spacing:0.8px;text-transform:uppercase;">Email</th>
									</tr>
								</thead>
								<tbody>
									{% for participant in participants %}
										<tr style="border-bottom:1px solid var(--sec-border);">
											<td style="padding:10px 0;color:var(--sec-text-muted);">{{ loop.index }}</td>
											<td style="padding:10px 0;font-weight:500;">{{ participant.nom }}</td>
											<td style="padding:10px 0;">{{ participant.prenom }}</td>
											<td style="padding:10px 0;">{{ participant.email }}</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						{% else %}
							<p style="color:var(--sec-text-muted);font-style:italic;margin:0;">Aucun participant inscrit pour le moment.</p>
						{% endif %}
					</div>
				</div>





				</div>
			</main>
		</div>
	</div>
{% endblock %}
