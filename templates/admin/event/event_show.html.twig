{% extends 'base.html.twig' %}

{% block title %}
	{{ event.titre }}
	— Admin
{% endblock %}

{% block body %}
	<div class="container-fluid px-0">
		<div
			class="admin-wrap">

			{# ── SIDEBAR ── #}
			<aside class="sidebar">
				<div class="sidebar-logo">
					<span class="dot"></span>
					SecurEvent
				</div>
				<nav class="sidebar-nav">
					<div class="nav-label">Navigation</div>
					<a href="{{ path('app_admin_dashboard') }}" class="nav-link">
						<svg fill="none" viewbox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
						Dashboard
					</a>
					<div class="nav-label">Gestion</div>
					<a href="#" class="nav-link active">
						<svg fill="none" viewbox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
						Détail événement
					</a>
				</nav>
				<div class="sidebar-footer">
					Connecté :<br>
					<strong>{{ app.user.email }}</strong><br>
					<a href="{{ path('app_logout') }}">Se déconnecter</a>
				</div>
			</aside>

			{# ── MAIN ── #}
			<main
				class="admin-main">

				{# Breadcrumb #}
				<nav style="font-size:0.75rem; color:#64748b; margin-bottom:20px; font-family:'JetBrains Mono',monospace;">
					<a href="{{ path('app_admin_dashboard') }}" style="color:#22d3ee; text-decoration:none;">Dashboard</a>
					<span style="margin:0 8px;">›</span>
					<span>{{ event.titre }}</span>
				</nav>

				{# Flash #}
				{% for msg in app.flashes('success') %}
					<div class="flash flash-success">{{ msg }}</div>
				{% endfor %}
				{% for msg in app.flashes('danger') %}
					<div class="flash flash-danger">{{ msg }}</div>
				{% endfor %}

				{# ── HEADER ── #}
				<div style="display:flex; align-items:flex-start; justify-content:space-between; gap:16px; margin-bottom:24px; padding-bottom:20px; border-bottom:1px solid rgba(255,255,255,0.06);">
					<div>
						<div style="display:flex; align-items:center; gap:10px; margin-bottom:6px; flex-wrap:wrap;">
							<h1 style="font-family:'Rajdhani',sans-serif; font-size:1.6rem; font-weight:700; letter-spacing:1px; margin:0; color:#f0f6ff;">
								{{ event.titre }}
							</h1>
							{% if event.isPublished %}
								<span class="badge badge-published">Publié</span>
							{% else %}
								<span class="badge badge-draft">Brouillon</span>
							{% endif %}
							{% if event.dateDebut > date() %}
								<span class="badge badge-upcoming">À venir</span>
							{% else %}
								<span class="badge badge-past">Passé</span>
							{% endif %}
						</div>
						<p style="font-size:0.78rem; color:#64748b; margin:0; font-family:'JetBrains Mono',monospace;">
							ID #{{ event.id }}
							— créé dans la base de données
						</p>
					</div>
					<div style="display:flex; gap:8px; flex-shrink:0; flex-wrap:wrap;">
						<a href="{{ path('admin_event_edit', {'id': event.id}) }}" class="btn btn-success btn-sm">
							<svg fill="none" viewbox="0 0 24 24" stroke="currentColor" style="width:13px;height:13px;vertical-align:middle;margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
							Modifier
						</a>
						<a href="{{ path('admin_event_participants', {'id': event.id}) }}" class="btn btn-sm" style="background:rgba(34,211,238,0.08); border:1px solid rgba(34,211,238,0.2); color:#22d3ee;">
							<svg fill="none" viewbox="0 0 24 24" stroke="currentColor" style="width:13px;height:13px;vertical-align:middle;margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
							Participants
						</a>
						<form method="post" action="{{ path('admin_event_delete', {'id': event.id}) }}" onsubmit="return confirm('Supprimer définitivement cet événement ?');" style="display:inline;">
							<input type="hidden" name="_token" value="{{ csrf_token('delete-event-' ~ event.id) }}">
							<button type="submit" class="btn btn-sm" style="background:rgba(248,113,113,0.08); border:1px solid rgba(248,113,113,0.2); color:#f87171;">
								<svg fill="none" viewbox="0 0 24 24" stroke="currentColor" style="width:13px;height:13px;vertical-align:middle;margin-right:4px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
								Supprimer
							</button>
						</form>
						<a href="{{ path('app_admin_dashboard') }}" class="btn btn-sm" style="border:1px solid rgba(255,255,255,0.1); color:#64748b; background:transparent;">← Retour</a>
					</div>
				</div>

				{# ── INFO CARDS ── #}
				<div
					style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:20px;">

					{# Infos principales #}
					<div class="panel" style="margin-bottom:0;">
						<div class="panel-header">
							<span class="panel-title">Informations</span>
						</div>
						<div style="padding:1.25rem 1.5rem;">
							<table style="width:100%; font-size:0.82rem; border-collapse:collapse;">
								<tr style="border-bottom:1px solid rgba(255,255,255,0.06);">
									<td style="padding:10px 0; color:#64748b; width:40%; font-size:0.68rem; letter-spacing:1px; text-transform:uppercase; font-family:'JetBrains Mono',monospace;">Date de début</td>
									<td style="padding:10px 0; font-weight:500; color:#f0f6ff;">{{ event.dateDebut|date("d/m/Y à H:i") }}</td>
								</tr>
								<tr style="border-bottom:1px solid rgba(255,255,255,0.06);">
									<td style="padding:10px 0; color:#64748b; font-size:0.68rem; letter-spacing:1px; text-transform:uppercase; font-family:'JetBrains Mono',monospace;">Lieu</td>
									<td style="padding:10px 0; font-weight:500; color:#f0f6ff;">{{ event.lieu }}</td>
								</tr>
								<tr style="border-bottom:1px solid rgba(255,255,255,0.06);">
									<td style="padding:10px 0; color:#64748b; font-size:0.68rem; letter-spacing:1px; text-transform:uppercase; font-family:'JetBrains Mono',monospace;">Capacité max</td>
									<td style="padding:10px 0; font-weight:500; color:#f0f6ff;">{{ event.capaciteMax }}
										places</td>
								</tr>
								<tr>
									<td style="padding:10px 0; color:#64748b; font-size:0.68rem; letter-spacing:1px; text-transform:uppercase; font-family:'JetBrains Mono',monospace;">Statut</td>
									<td style="padding:10px 0;">
										{% if event.isPublished %}
											<span class="badge badge-published">Publié</span>
										{% else %}
											<span class="badge badge-draft">Brouillon</span>
										{% endif %}
									</td>
								</tr>
							</table>
						</div>
					</div>

					{# Description #}
					<div class="panel" style="margin-bottom:0;">
						<div class="panel-header">
							<span class="panel-title">Description</span>
						</div>
						<div style="padding:1.25rem 1.5rem; font-size:0.85rem; line-height:1.7; color:#f0f6ff;">
							{% if event.description %}
								{{ event.description|nl2br }}
							{% else %}
								<span style="color:#64748b; font-style:italic;">Aucune description renseignée.</span>
							{% endif %}
						</div>
					</div>

				</div>

			</main>
		</div>
	</div>
{% endblock %}
