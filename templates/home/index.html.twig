{% extends 'base.html.twig' %}

{% block title %}Accueil - SecurEvent
{% endblock %}

{% block body %}
	<div class="text-center mt-5">
		<h1>🔐 Bienvenue sur SecurEvent</h1>
		<p class="lead text-muted mt-3">
			La plateforme de référence pour les conférences et CTF en cybersécurité.
		</p>
		{% if app.user and 'ROLE_USER' in app.user.roles %}
			<div class="mt-4">
				<a href="{{ path('app_event_index') }}" class="btn btn-outline-danger">Accéder aux Events</a>
			</div>
		{% endif %}
	</div>
{% endblock %}
