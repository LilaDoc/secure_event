{% extends 'base.html.twig' %}

{% block title %}Créer un compte — SecurEvent
{% endblock %}

{% block body %}

	<section style="min-height: 80vh; display:flex; align-items:center; padding: 3rem 0;">
		<div class="container">
			<div class="row justify-content-center">
				<div
					class="col-md-5">

					{# HEADER #}
					<div style="text-align:center; margin-bottom:2rem;">
						<span class="section-label" style="justify-content:center; display:block;">Rejoindre SecurEvent</span>
						<h1 style="font-family:'Rajdhani',sans-serif; font-size:2rem; font-weight:700; color:#f0f6ff; margin-bottom:0.5rem;">
							Créer un compte
						</h1>
						<p style="font-size:0.88rem; color:#64748b;">
							Accédez à tous les événements cybersécurité.
						</p>
					</div>

					{# FORM CARD #}
					<div class="events-wrapper">
						<div style="padding:1.75rem;">

							{{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}

							<div style="display:flex; flex-direction:column; gap:1.1rem;">

								<div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
									<div>
										{{ form_label(registrationForm.prenom, null, {'label_attr': {
                                        'style': 'display:block; font-family:\'JetBrains Mono\',monospace; font-size:0.68rem; letter-spacing:1.5px; text-transform:uppercase; color:#64748b; margin-bottom:0.4rem;'
                                    }}) }}
										{{ form_widget(registrationForm.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
										{{ form_errors(registrationForm.prenom) }}
									</div>
									<div>
										{{ form_label(registrationForm.nom, null, {'label_attr': {
                                        'style': 'display:block; font-family:\'JetBrains Mono\',monospace; font-size:0.68rem; letter-spacing:1.5px; text-transform:uppercase; color:#64748b; margin-bottom:0.4rem;'
                                    }}) }}
										{{ form_widget(registrationForm.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom'}}) }}
										{{ form_errors(registrationForm.nom) }}
									</div>
								</div>

								<div>
									{{ form_label(registrationForm.email, null, {'label_attr': {
                                    'style': 'display:block; font-family:\'JetBrains Mono\',monospace; font-size:0.68rem; letter-spacing:1.5px; text-transform:uppercase; color:#64748b; margin-bottom:0.4rem;'
                                }}) }}
									{{ form_widget(registrationForm.email, {'attr': {'class': 'form-control', 'placeholder': 'votre@email.com'}}) }}
									{{ form_errors(registrationForm.email) }}
								</div>

								<div>
									{{ form_label(registrationForm.plainPassword.first, null, {'label_attr': {
                                    'style': 'display:block; font-family:\'JetBrains Mono\',monospace; font-size:0.68rem; letter-spacing:1.5px; text-transform:uppercase; color:#64748b; margin-bottom:0.4rem;'
                                }}) }}
									{{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
									{{ form_errors(registrationForm.plainPassword.first) }}
								</div>

								<div>
									{{ form_label(registrationForm.plainPassword.second, null, {'label_attr': {
                                    'style': 'display:block; font-family:\'JetBrains Mono\',monospace; font-size:0.68rem; letter-spacing:1.5px; text-transform:uppercase; color:#64748b; margin-bottom:0.4rem;'
                                }}) }}
									{{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
									{{ form_errors(registrationForm.plainPassword.second) }}
								</div>

							</div>

							<button type="submit" class="btn-cta" style="width:100%; text-align:center; margin-top:1.5rem; padding:0.8rem; font-size:0.95rem; border:none; cursor:pointer;">
								Créer mon compte
							</button>

							{{ form_end(registrationForm) }}

							<div style="margin-top:1.5rem; padding-top:1.25rem; border-top:1px solid rgba(255,255,255,0.06); text-align:center;">
								<p style="font-size:0.85rem; color:#64748b; margin:0;">
									Déjà un compte ?
									<a href="{{ path('app_login') }}" style="color:#22d3ee; font-weight:500;">Se connecter</a>
								</p>
							</div>

						</div>
					</div>

				</div>
			</div>
		</div>
	</section>

{% endblock %}
