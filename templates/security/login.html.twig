{% extends 'base.html.twig' %}

{% block title %}Connexion - SecurEvent
{% endblock %}

{% block body %}
	<div class="row justify-content-center">
		<div class="col-md-5">
			<div class="card shadow-sm mt-5">
				<div class="card-body p-4">
					<h2 class="card-title mb-4">Connexion</h2>

					{% if error %}
						<div
							class="alert alert-danger">
							{# Message générique pour éviter l'user enumeration #}
							Identifiants invalides.
						</div>
					{% endif %}

					<form method="post">
						<div class="mb-3">
							<label for="inputEmail" class="form-label">Email</label>
							<input type="email" id="inputEmail" name="_username" class="form-control" value="{{ last_username }}" autocomplete="email" required>
						</div>
						<div class="mb-3">
							<label for="inputPassword" class="form-label">Mot de passe</label>
							<input type="password" id="inputPassword" name="_password" class="form-control" autocomplete="current-password" required>
						</div>

						{# Token CSRF généré par Symfony #}
						<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

						<button type="submit" class="btn btn-primary w-100">Se connecter</button>
					</form>

					<hr>
					<p class="text-center mb-0">
						Pas encore de compte ?
						<a href="{{ path('app_register') }}">S'inscrire</a>
					</p>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
