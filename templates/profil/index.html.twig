{% extends 'base.html.twig' %}

{% block title %}Mon espace — SecurEvent
{% endblock %}

{% block body %}

	<section class="section" style="padding-top: 3rem;">
		<div
			class="container">

			{# INFOS UTILISATEUR #}
			<div class="events-wrapper" style="margin-bottom: 2rem;">
				<div style="padding: 1.5rem 1.75rem;">
					<span class="section-label" style="margin-bottom: 0.75rem;">Mon compte</span>
					<div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem;">
						<div style="display:flex; flex-direction:column; gap:0.5rem;">
							<p style="font-size:0.88rem; color:#64748b; font-family:'JetBrains Mono',monospace; margin:0;">
								<span style="color:#f0f6ff; font-weight:600;">{{ app.user.prenom }}
									{{ app.user.nom }}</span>
							</p>
							<p style="font-size:0.82rem; color:#64748b; font-family:'JetBrains Mono',monospace; margin:0;">
								{{ app.user.email }}
							</p>
						</div>
						<a href="{{ path('app_profil_edit') }}" class="btn-view" style="font-size:0.8rem; padding:0.4rem 1rem;">
							✏️ Modifier mon profil
						</a>
					</div>
				</div>
			</div>

			{# HEADER ÉVÉNEMENTS #}
			<div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-4">
				<div>
					<span class="section-label">Mon espace</span>
					<h1 class="section-title" style="margin-bottom: 0.5rem;">Mes événements</h1>
					<p class="section-subtitle" style="margin: 0;">
						Les événements auxquels vous êtes inscrit(e).
					</p>
				</div>
				<a href="{{ path('app_home') }}" class="btn-cta-outline" style="align-self:center; font-size:0.85rem; padding: 0.6rem 1.4rem;">
					← Découvrir d'autres événements
				</a>
			</div>

			{# TABLE ÉVÉNEMENTS #}
			<div class="events-wrapper">

				{% if events is empty %}

					<div style="text-align:center; padding: 4rem 1rem;">
						<div style="font-size: 2.5rem; margin-bottom: 1rem;">📭</div>
						<p style="color:#64748b; font-family:'JetBrains Mono',monospace; font-size: 0.85rem; margin-bottom: 1.5rem;">
							Vous n'êtes inscrit(e) à aucun événement pour le moment.
						</p>
						<a href="{{ path('app_home') }}" class="btn-cta" style="font-size:0.88rem; padding: 0.7rem 1.8rem;">
							Voir les événements disponibles
						</a>
					</div>

				{% else %}

					<table class="table">
						<thead>
							<tr>
								<th>Titre</th>
								<th class="d-none d-md-table-cell">Description</th>
								<th>Date</th>
								<th class="d-none d-sm-table-cell">Lieu</th>
								<th class="d-none d-sm-table-cell">Capacité</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{% for event in events %}
								<tr>
									<td>
										<strong style="color:#f0f6ff; font-size:0.9rem;">
											{{ event.titre }}
										</strong>
									</td>
									<td class="d-none d-md-table-cell" style="color:#64748b; max-width:240px; font-size:0.85rem;">
										{{ event.description|length > 70 ? event.description|slice(0, 70) ~ '…' : event.description }}
									</td>
									<td style="white-space:nowrap;">
										<span style="font-family:'JetBrains Mono',monospace; font-size:0.78rem; color:#64748b;">
											{{ event.dateDebut ? event.dateDebut|date('d/m/Y') : '—' }}
										</span>
										<br>
										{% if event.dateDebut and event.dateDebut > date() %}
											<span style="font-size:0.68rem; color:#4ade80; font-family:'JetBrains Mono',monospace;">À venir</span>
										{% else %}
											<span style="font-size:0.68rem; color:#64748b; font-family:'JetBrains Mono',monospace;">Passé</span>
										{% endif %}
									</td>
									<td class="d-none d-sm-table-cell" style="color:#64748b; font-size:0.85rem;">
										{{ event.lieu }}
									</td>
									<td class="d-none d-sm-table-cell">
										<span class="event-tag">{{ event.capaciteMax }}
											places</span>
									</td>
									<td>
										<a href="{{ path('app_event_show', {'id': event.id}) }}" class="btn-view">
											Voir →
										</a>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>

				{% endif %}

			</div>

		</div>
	</section>

{% endblock %}
